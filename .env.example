# ========================================================
# Aura AI - Configuration d'environnement (.env)
# ========================================================

# [OPTIONNEL - RECOMMANDÉ SI EXPOSÉ] Jeton d'authentification pour protéger toutes les routes /api/*
# Si défini, l'interface demandera ce mot de passe/token au démarrage.
# Exemple : openssl rand -hex 32
AUTH_TOKEN=""

# [OPTIONNEL] Clé API Google Gemini (si vous souhaitez utiliser Gemini pour le chat ou la vision)
# Si vous utilisez Ollama local, LM Studio, Groq ou OpenRouter, laissez vide.
GEMINI_API_KEY=""

# [OPTIONNEL] URL de base de l'application
# Note : Aura AI fonctionne avec des chemins relatifs (/api/chat, /api/tts-proxy),
# cette variable n'est donc pas bloquante.
# - En local / Docker : http://localhost:9876
# - En production derrière un reverse proxy HTTPS : https://votre-domaine.com
APP_URL="http://localhost:9876"

# Port du serveur (par défaut 9876, aligné avec Dockerfile et docker-compose.yml)
PORT=9876

